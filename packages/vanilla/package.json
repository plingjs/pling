{
  "name": "@plingjs/vanilla",
  "version": "0.1.0-alpha.2",
  "private": false,
  "type": "module",
  "description": "Pling 的原生 JS 适配器：用普通 DOM 元素声明动作、记录、区域与只读状态，并接入浮动问答入口",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plingjs/pling.git",
    "directory": "packages/vanilla"
  },
  "homepage": "https://plingjs.dev",
  "bugs": "https://github.com/plingjs/pling/issues",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/write-package-manifest.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plingjs/agent": "workspace:*",
    "@plingjs/core": "workspace:*",
    "@plingjs/dom": "workspace:*",
    "@plingjs/ui": "workspace:*",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "jsdom": "^25",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^2"
  }
}
