{
  "name": "@plingjs/vanilla",
  "version": "0.1.0-alpha.7",
  "private": false,
  "type": "module",
  "description": "Pling vanilla JS adapter: declare actions, records, regions, and read-only state on DOM elements.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plingjs/pling.git",
    "directory": "packages/vanilla"
  },
  "homepage": "https://plingjs.dev",
  "bugs": "https://github.com/plingjs/pling/issues",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/write-package-manifest.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plingjs/agent": "workspace:*",
    "@plingjs/core": "workspace:*",
    "@plingjs/dom": "workspace:*",
    "@plingjs/surface": "workspace:*",
    "@plingjs/surface-browser": "workspace:*",
    "@plingjs/ui": "workspace:*",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "jsdom": "^25",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^2"
  }
}
