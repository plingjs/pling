{
  "name": "@plingjs/delegation",
  "version": "0.1.0-alpha.2",
  "private": false,
  "type": "module",
  "description": "Pling 委托凭证集成包：稳定契约、内存适配器、SurfaceSession 映射、浏览器客户端与 Web HTTP/SSE handler",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plingjs/pling.git",
    "directory": "packages/delegation"
  },
  "homepage": "https://plingjs.dev",
  "bugs": "https://github.com/plingjs/pling/issues",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/write-package-manifest.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plingjs/surface": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^2"
  }
}
