{
  "name": "@plingjs/continuity-http",
  "version": "0.1.0-alpha.2",
  "private": false,
  "type": "module",
  "description": "Pling 跨设备任务连续性集成包：浏览器 HTTP authority / Web Request→Response handler / 测试内存后端",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plingjs/pling.git",
    "directory": "packages/continuity-http"
  },
  "homepage": "https://plingjs.dev",
  "bugs": "https://github.com/plingjs/pling/issues",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/write-package-manifest.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plingjs/agent": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^2"
  }
}
