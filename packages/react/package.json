{
  "name": "@plingjs/react",
  "version": "0.1.0-alpha.10",
  "private": false,
  "type": "module",
  "description": "Pling React adapter: actions, records, regions, read-only state, and an inline assistant entry point.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plingjs/pling.git",
    "directory": "packages/react"
  },
  "homepage": "https://plingjs.dev",
  "bugs": "https://github.com/plingjs/pling/issues",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./legacy": {
      "types": "./src/legacy.tsx",
      "default": "./src/legacy.tsx"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/write-package-manifest.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plingjs/agent": "workspace:*",
    "@plingjs/core": "workspace:*",
    "@plingjs/dom": "workspace:*",
    "@plingjs/ui": "workspace:*",
    "@plingjs/vanilla": "workspace:*",
    "use-sync-external-store": "^1.5.0",
    "markdown-it": "^15.0.3"
  },
  "peerDependencies": {
    "react": ">=16.3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/use-sync-external-store": "^1.7.0",
    "jsdom": "^25",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^2"
  }
}
