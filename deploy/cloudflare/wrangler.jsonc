{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "plingjs-dev",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../website/.vitepress/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "plingjs.dev", "custom_domain": true },
    { "pattern": "www.plingjs.dev", "custom_domain": true }
  ],
  "ratelimits": [
    {
      "name": "MODEL_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "PLING_ALLOWED_ORIGINS": "https://plingjs.dev,https://www.plingjs.dev",
    "PLING_PUBLIC_ACCESS": "false"
  },
  "observability": {
    "enabled": true
  }
}
