{
	email {$ACME_EMAIL:admin@example.com}
}

{$PLING_WWW_HOST:www.example.com} {
	redir https://{$PLING_DOCS_HOST:example.com}{uri} permanent
}

{$PLING_DOCS_HOST:example.com} {
	handle_path /api/agent/* {
		reverse_proxy api:5192
	}

	root * /srv/pling/website
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	file_server
}

{$PLING_DEMO_HOST:demo.example.com} {
	@root path /
	redir @root /demos/quickstart/ 302

	handle_path /api/agent/* {
		reverse_proxy api:5192
	}

	root * /srv/pling/demo
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	file_server
}

{$PLING_API_HOST:api.example.com} {
	@api path /v1/* /health
	handle @api {
		reverse_proxy api:5192
	}
	respond 404
}

{$PLING_SURFACE_HOST:surface.example.com} {
	reverse_proxy surface:5219
}

{$PLING_TODO_HOST:todo.example.com} {
	encode zstd gzip
	reverse_proxy todo:5221
}
