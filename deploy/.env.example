# Model proxy (server-side only). Copy this file to deploy/.env.
PLING_UPSTREAM_BASE_URL=https://your-openai-compatible-provider.example/v1
PLING_UPSTREAM_API_KEY=replace-with-provider-key
PLING_MODEL=replace-with-model-name
PLING_DEMO_RATE_LIMIT=80
PLING_DEMO_RATE_WINDOW_MS=600000
PLING_TIMEOUT_MS=60000
PLING_IMAGE=plingjs:amd64

# Public hostnames. The VPS can serve business hosts on a different registrable
# domain from the Cloudflare-hosted documentation site.
PLING_DOCS_HOST=plingjs.dev
PLING_WWW_HOST=www.plingjs.dev
PLING_DEMO_HOST=demo.plingjs.dev
PLING_API_HOST=api.plingjs.dev
PLING_SURFACE_HOST=surface.example.com
PLING_TODO_HOST=todo.example.com
PLING_CERT_NAME=example.com
PLING_HOSTS=surface.example.com,todo.example.com

# Surface Gateway control-plane secret. Generate with: openssl rand -hex 32
SURFACE_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
SURFACE_TENANT_ID=demo
TODO_SURFACE_SCOPES=add_task,toggle@,delete@,clear_completed

# Browser origin allowed to call the authenticated Todo BFF.
TODO_ALLOWED_ORIGINS=https://todo.example.com

# Public origin returned by the Surface Gateway.
SURFACE_PUBLIC_BASE_URL=https://surface.example.com

# Let's Encrypt account email.
ACME_EMAIL=you@example.com
