{
  "name": "@plingjs/examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Curated, production-facing Pling examples used by the online playground",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config ./vite.config.ts --port 5191 --strictPort",
    "dev:react19": "vite --config ./demos/course-workspace-react/vite.config.ts",
    "dev:gateway": "node gateway.mjs",
    "build": "vite build --config ./vite.config.ts && vite build --config ./demos/course-workspace-react/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "surface:mcp": "node demos/external-agent-surface/mcp-server.mjs",
    "surface:smoke": "node demos/external-agent-surface/scripts/mcp-smoke.mjs",
    "test": "vitest run --root . shared"
  },
  "dependencies": {
    "@plingjs/agent": "workspace:*",
    "@plingjs/core": "workspace:*",
    "@plingjs/react": "workspace:*",
    "@plingjs/server": "workspace:*",
    "@plingjs/surface": "workspace:*",
    "@plingjs/vanilla": "workspace:*",
    "@plingjs/vue": "workspace:*",
    "@plingjs/vue2": "workspace:*",
    "react": "16.3.0",
    "react-dom": "16.3.0",
    "vue": "^3",
    "vue2": "npm:vue@2.7.16",
    "vue-router": "^4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "@vitejs/plugin-vue": "^5",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^2"
  }
}
