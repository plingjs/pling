# Copy this file to examples/.env.local for local development.
# Only VITE_* values reach the browser. They contain no secrets.
VITE_AGENT_BASE_URL=/api/agent/v1
VITE_AGENT_MODEL=your-model-name
VITE_AGENT_MIN_ACTION_INTERVAL_MS=320

# Server-only values. Read by examples/gateway.mjs and never sent to the browser.
PLING_UPSTREAM_BASE_URL=https://your-openai-compatible-host/v1
PLING_UPSTREAM_API_KEY=replace-me
PLING_MODEL=your-model-name
PLING_GATEWAY_PORT=5192
PLING_DEMO_RATE_LIMIT=80
PLING_DEMO_RATE_WINDOW_MS=600000
