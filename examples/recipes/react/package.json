{
  "name": "@plingjs/recipe-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable React recipe lab: form validation, dangerous actions, search, state, continuity, and host-owned connection settings",
  "scripts": {
