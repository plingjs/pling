# Browser-safe values. Vite exposes only VITE_* variables.
VITE_AGENT_BASE_URL=/llm/v1
VITE_AGENT_MODEL=your-model-name
VITE_AGENT_MIN_ACTION_INTERVAL_MS=320

# Optional model proxy for the in-page Agent. The demo also supports BYOK in the
# assistant's Activity panel, so this is not required for third-party Surface.
VITE_AGENT_PROXY_TARGET=http://127.0.0.1:5192

# Server-only values. Never expose these to the browser.
TODO_BFF_PORT=5221
TODO_DIST=
TODO_ALLOWED_ORIGINS=http://127.0.0.1:5220,http://localhost:5220
SURFACE_GATEWAY_URL=http://127.0.0.1:5219
SURFACE_ADMIN_TOKEN=replace-with-a-32-byte-random-token
SURFACE_TENANT_ID=demo

# Optional comma-separated subset of the four capabilities implemented by this
# page. Default: add_task,toggle@,delete@,clear_completed
TODO_SURFACE_SCOPES=add_task,toggle@,delete@,clear_completed
