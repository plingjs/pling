# Local preview only. VITE_* values are embedded in browser code.
# Never put a production provider key here; production traffic belongs behind the gateway.
# Copy this file to .env.local and use a restricted, disposable development credential.
VITE_AGENT_BASE_URL=https://api.example.com/v1
VITE_AGENT_MODEL=chat-model
VITE_AGENT_API_KEY=replace-with-a-development-key
